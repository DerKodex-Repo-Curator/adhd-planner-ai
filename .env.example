# ADHD Planner AI Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# TELEGRAM BOT
# =============================================================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your personal chat ID (the bot will only respond to this user)
# Start a chat with @userinfobot to get your ID
TELEGRAM_CHAT_ID=your-chat-id-here

# =============================================================================
# CLAUDE API
# =============================================================================
# Get your API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Model to use (claude-3-5-sonnet-latest recommended for speed/quality balance)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =============================================================================
# CHECK-IN SETTINGS
# =============================================================================
# How often to check in during work hours (minutes)
CHECK_IN_INTERVAL_MINUTES=45

# Work hours (24h format) - only send proactive messages during these hours
CHECK_IN_START_HOUR=9
CHECK_IN_END_HOUR=18

# Days to send check-ins (0=Sunday, 1=Monday, etc.)
CHECK_IN_DAYS=1,2,3,4,5

# =============================================================================
# FOCUS SESSION
# =============================================================================
# Default pomodoro duration (minutes)
POMODORO_DURATION_MINUTES=25

# Default break duration (minutes)
BREAK_DURATION_MINUTES=5

# Long break after N pomodoros
POMODOROS_BEFORE_LONG_BREAK=4
LONG_BREAK_DURATION_MINUTES=15

# =============================================================================
# APPLE REMINDERS (macOS only)
# =============================================================================
# Enable Apple Reminders sync
ENABLE_APPLE_REMINDERS=false

# Name of the Reminders list to use (will be created if doesn't exist)
APPLE_REMINDERS_LIST=ADHD Planner

# =============================================================================
# DATA STORAGE
# =============================================================================
# Directory for data files (SQLite DB, memory JSON, etc.)
DATA_DIR=./data

# =============================================================================
# DOPAMINE SYSTEM
# =============================================================================
# Base points per task completion
BASE_POINTS_PER_TASK=10

# Chance of random bonus (0-1)
RANDOM_BONUS_CHANCE=0.2

# Max random bonus points
MAX_RANDOM_BONUS=25
