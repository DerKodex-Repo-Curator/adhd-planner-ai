{
  "name": "adhd-planner-ai",
  "version": "1.0.0",
  "description": "ADHD-friendly AI personal assistant built on OpenClaw patterns - proactive check-ins, time-blind scheduling, and dopamine-aware task management",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "setup": "tsx src/setup.ts",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "adhd",
    "planner",
    "ai",
    "telegram",
    "productivity",
    "task-management",
    "openclaw",
    "claude",
    "anthropic",
    "ai-agent"
  ],
  "author": "ran2207",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ran2207/adhd-planner-ai"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.0",
    "node-cron": "^3.0.3",
    "telegraf": "^4.16.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
